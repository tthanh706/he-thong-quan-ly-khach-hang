{
  "name": "crm/s1-10-account-lock",
  "type": "project",
  "description": "S1-10 khóa tài khoản và bàn giao dữ liệu",
  "require": {
    "php": "^8.3",
    "laravel/framework": "^13.0",
    "laravel/sanctum": "^4.3"
  },
  "require-dev": {
    "fakerphp/faker": "^1.24",
    "laravel/pint": "^1.24",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.8",
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {"Tests\\": "tests/"}
  },
  "scripts": {
    "lint": "pint --test",
    "test": "php artisan test"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
